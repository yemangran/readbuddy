# Optional overrides for the extension's runtime configuration.
# The extension is local-first: no website, API, or authorization-cookie
# domains are configured here, so nothing can point it at a remote host it
# does not need.
#
# WXT_USE_LOCAL_PACKAGES=true aliases @read-frog/definitions to a local
# monorepo checkout instead of the published package.
#
# Required in production:
# WXT_GOOGLE_CLIENT_ID=your-google-client-id
# WXT_POSTHOG_HOST=https://us.i.posthog.com
# WXT_POSTHOG_API_KEY=phc_your_posthog_key
# WXT_ANALYTICS_DAILY_FEATURE_CACHE_ENABLED=false
